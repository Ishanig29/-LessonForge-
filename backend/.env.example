# ---- AI (required for objective analysis, generation and both QC layers) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model id that supports JSON output. Change if Google retires it.
GEMINI_MODEL=gemini-3.5-flash
AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=180
AI_MAX_RETRIES=2

# ---- Research ----
# Web research (required for evidence): https://app.tavily.com
TAVILY_API_KEY=
# Optional: Google Books works without a key at a lower quota
GOOGLE_BOOKS_API_KEY=
# YouTube Data API v3 key (Google Cloud console -> enable "YouTube Data API v3")
YOUTUBE_API_KEY=
HTTP_TIMEOUT_SECONDS=25

# ---- App ----
# Offline demo mode: uses clearly labelled fixture data instead of live APIs.
DEMO_MODE=false
# DATABASE_URL=sqlite:///absolute/path/to/lessonforge.db   (default: backend/instance/lessonforge.db)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
